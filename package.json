{
  "name": "mailifier",
  "version": "0.1.0",
  "description": "Ask a mail server whether an address exists, over SMTP, without sending anything.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mailifier": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "lint": "biome check .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm bundle"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/mailifier.git"
  },
  "homepage": "https://github.com/wrenautomation/mailifier#readme",
  "bugs": {
    "url": "https://github.com/wrenautomation/mailifier/issues"
  },
  "keywords": [
    "email",
    "verification",
    "smtp",
    "mailbox",
    "deliverability",
    "bounce",
    "mx",
    "rcpt"
  ],
  "publishConfig": {
    "access": "public"
  }
}
